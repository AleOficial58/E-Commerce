rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function mediaDocument(mediaId) {
      return /databases/(default)/documents/productReviewMedia/$(mediaId);
    }

    function mediaData(mediaId) {
      return firestore.get(mediaDocument(mediaId)).data;
    }

    match /product-review-media/{productId}/{reviewId}/{mediaId} {
      allow read: if firestore.exists(mediaDocument(mediaId))
        && mediaData(mediaId).status == 'approved';

      allow create: if signedIn()
        && firestore.exists(mediaDocument(mediaId))
        && mediaData(mediaId).status == 'uploading'
        && mediaData(mediaId).userId == request.auth.uid
        && mediaData(mediaId).productId == productId
        && mediaData(mediaId).reviewId == reviewId
        && mediaData(mediaId).storagePath == 'product-review-media/' + productId + '/' + reviewId + '/' + mediaId
        && mediaData(mediaId).fileSize == request.resource.size
        && mediaData(mediaId).contentType == request.resource.contentType
        && (
          (request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
            && request.resource.size > 0
            && request.resource.size <= 8 * 1024 * 1024)
          || (request.resource.contentType == 'video/mp4'
            && request.resource.size > 0
            && request.resource.size <= 25 * 1024 * 1024)
        );

      allow update, delete: if false;
    }
  }
}
